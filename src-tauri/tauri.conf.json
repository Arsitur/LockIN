{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LockIN",
  "version": "1.3.1",
  "identifier": "com.lockin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LockIN — Make room for focus.",
        "width": 1360,
        "height": 960,
        "minWidth": 800,
        "minHeight": 650,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#111211"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Your personal distraction switch",
    "category": "Productivity"
  }
}
